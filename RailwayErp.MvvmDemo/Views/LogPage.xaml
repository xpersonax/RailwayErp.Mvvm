<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RailwayErp.MvvmDemo.ViewModels"
             xmlns:models="clr-namespace:RailwayErp.MvvmDemo.Models"
             x:Class="RailwayErp.MvvmDemo.Views.LogPage"
             x:DataType="vm:LogViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="16,12,16,0">

        <!-- Поточна сесія з IAppStateService (singleton) -->
        <Border Style="{StaticResource Card}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                <Label Text="{Binding SessionText}" Style="{StaticResource SectionTitle}" AutomationId="SessionLabel" />
                <Label Grid.Row="1" Text="{Binding StateText}" FontFamily="OpenSansSemibold" AutomationId="LifecycleStateLabel" />
                <Label Grid.Row="2" Text="{Binding CountersText}" AutomationId="CountersLabel" />
                <Label Grid.Row="3" Text="{Binding SavedText}" Style="{StaticResource Caption}" AutomationId="SavedStateLabel" />
                <Label Grid.Row="4" Text="{Binding LogFilePath, StringFormat='Файл журналу: {0}'}" Style="{StaticResource Caption}"
                       LineBreakMode="CharacterWrap" />
                <Button Grid.Column="1" Grid.RowSpan="5" Text="Очистити" VerticalOptions="Center"
                        Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" AutomationId="ClearLogButton" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}" SelectionMode="None" AutomationId="LogList">
            <CollectionView.EmptyView>
                <Label Text="Журнал порожній" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LogEntry">
                    <Grid ColumnDefinitions="96,170,*" ColumnSpacing="10" Padding="4,5" Opacity="{Binding DisplayOpacity}">
                        <Label Text="{Binding TimeText}" FontSize="12" Style="{StaticResource Caption}"
                               FontFamily="{OnPlatform WinUI=Consolas, Android=monospace, iOS=Menlo, MacCatalyst=Menlo}" />
                        <Label Grid.Column="1" Text="{Binding SourceText}" FontSize="12" FontFamily="OpenSansSemibold"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Grid.Column="2" Text="{Binding Message}" FontSize="13" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
